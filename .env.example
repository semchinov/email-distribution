# region smtpSettings

SMTP_USER=your-login@your-domain.ru
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465

# endregion smtpSettings

# region emailSettings

EMAIL_SUBJECT="Доступ к LLM Proxy — API-ключ и документация"

# endregion emailSettings

# region delaySettings

SEND_DELAY=[5, 10]
BATCH_SIZE=10
BATCH_DELAY=[10, 20]

# endregion delaySettings

# region pathSettings
# По умолчанию пути считаются от корня проекта; относительные пути здесь — от текущей директории

# XLS_PATH=recipients.xls
# CSV_PATH=recipients.csv
# TEMPLATE_PATH=email_template.md

# endregion pathSettings
